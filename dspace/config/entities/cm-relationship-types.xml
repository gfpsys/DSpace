<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE relationships SYSTEM "relationship-types.dtd">

<relationships>
    <!-- Asesor(a) / director(a) de tesis: Publication -> Person -->
    <type>
        <leftType>Publication</leftType>
        <rightType>Person</rightType>
        <leftwardType>isAdvisorOfPublication</leftwardType>
        <rightwardType>isPublicationOfAdvisor</rightwardType>
        <leftCardinality>
            <min>0</min>
        </leftCardinality>
        <rightCardinality>
            <min>0</min>
        </rightCardinality>
        <copyToLeft>true</copyToLeft>
    </type>

    <!-- Revisor(a) / lector(a) de tesis: Publication -> Person -->
    <type>
        <leftType>Publication</leftType>
        <rightType>Person</rightType>
        <leftwardType>isReviewerOfPublication</leftwardType>
        <rightwardType>isPublicationOfReviewer</rightwardType>
        <leftCardinality>
            <min>0</min>
        </leftCardinality>
        <rightCardinality>
            <min>0</min>
        </rightCardinality>
        <copyToLeft>true</copyToLeft>
    </type>
</relationships>